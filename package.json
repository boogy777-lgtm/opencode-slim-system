{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-slim-system",
  "version": "3.0.0-v2.0",
  "private": true,
  "description": "Compact tool descriptions and opt-in, verified stock system prompts for OpenCode V2.",
  "type": "module",
  "license": "MIT",
  "author": "SK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boogy777-lgtm/opencode-slim-system.git"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "main": "./src/index.js",
  "files": [
    "src",
    "tool",
    "prompt",
    "README.md",
    "schema.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "scripts": {
    "gen-defaults": "node scripts/gen-defaults.js",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run gen-defaults && npm run typecheck && npm test",
    "test:live": "node scripts/live-smoke.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
